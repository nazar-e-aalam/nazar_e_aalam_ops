# Nazar Ops configuration. scripts/setup.sh creates .env from this file and fills in the database for you.
# Every variable starts with OPS_ so none of them leak into deployed apps.

# --- domains -------------------------------------------------------------------------------------------------------
# Panel:  ops.<OPS_ROOT_DOMAIN>      Public downloads:  ops.<OPS_ROOT_DOMAIN>/applications
# On localhost everything is served at http://localhost:8100  (panel at /ops/).
OPS_ROOT_DOMAIN=localhost
OPS_SUBDOMAIN=ops
# Set true once HTTPS works (secure cookies need it). install.sh does this for you with --ssl.
OPS_HTTPS=false

# --- database: MySQL / MariaDB (scripts/setup.sh installs it and fills these in) -----------------------------------------
OPS_DB_HOST=127.0.0.1
OPS_DB_PORT=3306
OPS_DB_NAME=nazar_ops
OPS_DB_USER=nazar_ops
OPS_DB_PASSWORD=
# OPS_DB_SOCKET=/var/run/mysqld/mysqld.sock     # optional: connect over a unix socket instead of host/port

# --- first login (used once, when the database is empty) ----------------------------------------------------------------
# Leave the password empty to get a random one printed in the terminal on first start.
OPS_ADMIN_EMAIL=admin@example.com
OPS_ADMIN_PASSWORD=
OPS_ADMIN_NAME=Admin
# Locked out? Set true + OPS_ADMIN_PASSWORD, restart once, log in, set back to false.
OPS_ADMIN_FORCE_PASSWORD=false

# --- GitHub (optional here: you can also paste the token in Settings > GitHub) -----------------------------------------
OPS_GITHUB_TOKEN=
OPS_GITHUB_ORG=nazar-e-aalam
OPS_APP_REPO=nazar_e_aalam_app
OPS_PANEL_REPO=nazar_e_aalam_panel
# Git clones and release downloads go through this mirror (empty = direct from GitHub).
OPS_GITHUB_PROXY=https://gh-proxy.org
OPS_GITHUB_PROXY_FALLBACK=true

# --- email (optional; leave the host empty to run without email) --------------------------------------------------------
OPS_SMTP_HOST=
OPS_SMTP_PORT=587
# starttls | ssl | none
OPS_SMTP_SECURITY=starttls
OPS_SMTP_USER=
OPS_SMTP_PASSWORD=
OPS_SMTP_FROM=
OPS_SMTP_FROM_NAME=Nazar Ops

# --- misc ------------------------------------------------------------------------------------------------------------
OPS_DATA_DIR=./data
OPS_MAX_UPLOAD_MB=800
OPS_SESSION_HOURS=168
# DEBUG | INFO | WARNING   (all logs go to the terminal / journal, never to files)
OPS_LOG_LEVEL=INFO
