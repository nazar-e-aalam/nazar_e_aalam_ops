# Copy to .env and fill in. Every variable starts with OPS_ so none of them leak into deployed apps.

# --- domains -----------------------------------------------------------------------
# The panel is served on  ops.<OPS_ROOT_DOMAIN>  and the public downloads on  <OPS_ROOT_DOMAIN>/applications
OPS_ROOT_DOMAIN=example.com
OPS_SUBDOMAIN=ops
# false only for local testing over plain http
OPS_HTTPS=true

# --- first login (seed) --------------------------------------------------------------
# Used once, when the database is empty. Leave the password empty to have a random one
# written to data/initial_admin_password.txt instead.
OPS_ADMIN_EMAIL=admin@example.com
OPS_ADMIN_PASSWORD=
OPS_ADMIN_NAME=Admin
# Locked out? Set true, restart once, log in, then set back to false (resets the password of OPS_ADMIN_EMAIL).
OPS_ADMIN_FORCE_PASSWORD=false

# --- GitHub ----------------------------------------------------------------------------
# Optional here: you can also paste the token in the panel (Settings > GitHub).
OPS_GITHUB_TOKEN=
OPS_GITHUB_ORG=nazar-e-aalam
OPS_APP_REPO=nazar_e_aalam_app
OPS_PANEL_REPO=nazar_e_aalam_panel
# Git clones and release downloads go through this mirror (empty = direct from GitHub).
OPS_GITHUB_PROXY=https://gh-proxy.org
# Retry direct from GitHub if the proxy fails (needed for private repos).
OPS_GITHUB_PROXY_FALLBACK=true

# --- email (optional) -------------------------------------------------------------------
# Leave the host empty to run without email: invites show a copyable link, "Forgot password?" is hidden.
# You can also set all of this in the panel (Settings > Email).
OPS_SMTP_HOST=
OPS_SMTP_PORT=587
# starttls | ssl | none
OPS_SMTP_SECURITY=starttls
OPS_SMTP_USER=
OPS_SMTP_PASSWORD=
OPS_SMTP_FROM=
OPS_SMTP_FROM_NAME=Nazar Ops

# --- misc ---------------------------------------------------------------------------------
OPS_DATA_DIR=./data
OPS_MAX_UPLOAD_MB=800
OPS_SESSION_HOURS=168
